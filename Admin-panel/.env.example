# Admin panel environment (build-time variables — commit-safe, no secrets).

# API base URL (defaults to same-origin /api).
# Local dev: leave EMPTY — vite.config.js proxies /api to http://localhost:4000.
# Deployed: set on the Vercel project for this build:
#   VITE_API_BASE=https://shushrutam-ved-api.onrender.com/api
# Local production-artifact build: uncomment below.
# VITE_API_BASE=https://shushrutam-ved-api.onrender.com/api
VITE_API_BASE=
