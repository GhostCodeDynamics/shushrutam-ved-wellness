# Environment
NODE_ENV=development

# Server
PORT=4000

# Express trust proxy hops: "1" behind a single reverse proxy / load balancer,
# "false" when exposed directly. Defaults to "1" in production, "false" in dev.
TRUST_PROXY=

# Comma-separated list of allowed browser origins (no trailing slash).
# In production this must list the website and admin panel origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
# Required in production. Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/shushrutamved-care
MONGODB_URI=

# Auth — REQUIRED in production. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# One-time bootstrap secret to create the first admin
# (POST /api/admin/setup OR npm run seed — see src/seed/seed.js).
# DELETE this after the first admin is created.
BOOTSTRAP_SECRET=
BOOTSTRAP_EMAIL=admin@shushrutamvedcare.in

# Email (SMTP) — used for appointment notifications. No mail server in dev by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShushrutamVed Care <no-reply@example.com>"
MAIL_TO=care@example.com

# Optional: pin the process to explicit DNS resolvers (comma-separated IPv4).
# Required only when the machine's local DNS refuses c-ares lookups for remote
# hosts (Atlas mongodb+srv shows "querySrv ECONNREFUSED" without this).
DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1

# ImageKit (admin image uploads). All three are required to enable uploads;
# uploads return 503 until the set is complete. Keys live in your ImageKit dashboard.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<YOUR-IMAGEKIT-ID>