# Frontend environment (build-time variables — commit-safe, no secrets).

# Analytics (Google Analytics 4). Leave empty to disable entirely.
# When set, the gtag script is loaded and page views are sent on client navigation.
VITE_GA_MEASUREMENT_ID=

# API base URL used by the site in non-production builds.
# Defaults to http://localhost:4000/api (dev) or same-origin /api (production).
VITE_API_BASE_URL=

# Canonical public domain used by scripts/generate-sitemap.mjs (no trailing slash).
SITE_URL=

# Optional live API used by scripts/generate-sitemap.mjs to merge blog posts into
# public/sitemap.xml (no trailing slash). Example: https://api.example.com/api
SITEMAP_API_URL=