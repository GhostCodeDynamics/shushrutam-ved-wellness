# Frontend environment (build-time variables — commit-safe, no secrets).

# Canonical public domain, e.g. https://shushrutamvedcare.in (no trailing slash).
# Single source of truth for canonical / og:url / og:image / JSON-LD / sitemap.
# - Baked into src/lib/site.js (absoluteUrl) at build time.
# - Read by scripts/generate-sitemap.mjs (prebuild) for sitemap.xml + robots.txt.
# - Injected into index.html by the siteOriginHtml plugin in vite.config.js.
# Local builds fall back to http://localhost:5173 when this is empty;
# CI/Vercel builds FAIL if it is missing, so a placeholder can never ship.
VITE_SITE_URL=

# Same origin, ops/build alias. Only used by scripts/generate-sitemap.mjs when
# VITE_SITE_URL is empty — keep the two identical.
SITE_URL=

# Google Search Console verification (HTML-tag method). In Search Console:
# Add property -> URL prefix https://<site> -> "HTML tag" -> copy the CONTENT
# value only. The build injects it into index.html (Google fetches raw HTML,
# no JS). Set it here for local builds and on the Vercel project for deploys,
# then redeploy. Note: a DNS TXT record cannot work on *.vercel.app because
# Vercel owns the DNS zone.
VITE_GOOGLE_SITE_VERIFICATION=

# Analytics (Google Analytics 4). Leave empty to disable entirely.
# When set, the gtag script is loaded and page views are sent on client navigation.
VITE_GA_MEASUREMENT_ID=

# API base URL used by the site in non-production builds.
# Defaults to http://localhost:4000/api (dev) or same-origin /api (production).
VITE_API_BASE_URL=

# Public API base used by scripts/generate-sitemap.mjs to merge published posts
# into public/sitemap.xml (no trailing slash). Example: https://api.example.com/api
# Falls back to VITE_API_BASE_URL, then to the local dev API.
SITEMAP_API_URL=
